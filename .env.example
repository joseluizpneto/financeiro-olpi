# Copie para .env e preencha com valores reais (NUNCA versione o arquivo .env):
#   cp .env.example .env

# --- Segurança (obrigatório preencher em produção / DEBUG=False) ---
# Gere SECRET_KEY com: python3 -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=
POSTGRES_PASSWORD=

# --- Usuário administrador criado na primeira subida (opcional) ---
# Recomenda-se apagar DJANGO_SUPERUSER_PASSWORD do .env após o primeiro acesso.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# --- Cadastros iniciais opcionais (usados apenas se o banco estiver vazio) ---
# Formato de SEED_TITULARES: Nome 1:PF,Nome 2:PF,Minha Empresa:PJ
SEED_TITULARES=
# O módulo empresarial (menu Empresa e filtro PF × PJ) é opcional:
# deixe SEED_EMPRESA_NOME vazio para usar apenas finanças pessoais (PF),
# ou preencha com o nome da empresa para ativá-lo na primeira subida.
SEED_EMPRESA_NOME=
SEED_EMPRESA_DESCRICAO=

# --- Endereços de acesso (Cloudflare Tunnel / HTTPS) ---
# Adicione o domínio do Cloudflare Tunnel (ex.: localhost,127.0.0.1,financas.seudominio.com.br)
ALLOWED_HOSTS=localhost,127.0.0.1
# Origem HTTPS completa (ex.: https://financas.seudominio.com.br)
CSRF_TRUSTED_ORIGINS=
# Use True atrás do Cloudflare Tunnel / HTTPS; use False apenas em teste HTTP local
COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
# Proteção contra tentativas de login
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
SESSION_COOKIE_AGE=1209600

# --- Porta local (escuta exclusivamente em 127.0.0.1 para o Cloudflare Tunnel) ---
PORTA=8000
# Usado apenas no perfil opcional --profile https (Caddy)
DOMINIO=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- Banco de dados ---
POSTGRES_DB=financas
POSTGRES_USER=financas
# Opcional: caminho do SQLite apenas quando executado sem PostgreSQL
SQLITE_PATH=

# --- Backup criptografado e integrações opcionais ---
# Chave pública age para criptografar backups automaticamente (opcional)
BACKUP_AGE_RECIPIENT=
# Telegram (também pode ser configurado pelo Painel Admin da aplicação)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Atualização via Git no Painel Admin (opcional; também configurável pelo painel) ---
# Formato owner/repositorio (ex.: usuario/financeiro-olpi)
GIT_UPDATE_REPO=
GIT_UPDATE_BRANCH=main
# Token PAT do GitHub com permissão Contents: Read-only (necessário para repositório privado)
GIT_UPDATE_TOKEN=

# --- Geral ---
DEBUG=False
LOG_LEVEL=INFO
TZ=America/Araguaina
